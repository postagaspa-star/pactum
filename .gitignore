# Android / Gradle
.gradle/
**/build/
local.properties
.kotlin/
captures/
*.iml

# Keystore: MAI nel repo (la chiave di firma è per sempre)
*.jks
*.keystore

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Dati locali
server/*.db
.env

# APK release: artefatti di build, consegnati fuori dal repo (server/apk/README.md
