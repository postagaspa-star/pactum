<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Auto-aggiornamento (tappa 6): installazione dell'APK nuovo via
         PackageInstaller. In sideload nessuna policy Play si applica; la firma
         con la stessa chiave e' la garanzia d'integrita' (architettura.md). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Visibilita' pacchetti: serve per mostrare nome delle app misurate.
         Sideload: nessuna policy Play si applica (architettura.md). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".PactumApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nome_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.PactumFiglio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".servizio.PactumService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Registro trasparente uso app per patto familiare figlio-genitore" />
        </service>

        <!-- Osservazione dei siti visitati (v2.3). VPN LOCALE che instrada SOLO
             il DNS: nessun altro traffico entra nel tunnel, niente viene mai
             bloccato. exported="true" con BIND_VPN_SERVICE e' la forma
             richiesta da Android: il permesso ce l'ha solo il sistema. -->
        <service
            android:name=".siti.OsservatoreSitiService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".avvio.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- TIME_SET e TIMEZONE_CHANGED sono esenti dalle restrizioni sui
             broadcast impliciti: dichiarabili nel manifest (architettura.md).
             Nota: la costante Intent.ACTION_TIME_CHANGED vale "android.intent.action.TIME_SET". -->
        <receiver
            android:name=".tempo.OrologioReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Esito della sessione di PackageInstaller (auto-aggiornamento).
             Interno: l'invoca solo il PendingIntent della sessione. -->
        <receiver
            android:name=".aggiornamento.InstallReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
