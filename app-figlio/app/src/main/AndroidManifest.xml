<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Auto-aggiornamento (tappa 6): installazione dell'APK nuovo via
         PackageInstaller. In sideload nessuna policy Play si applica; la firma
         con la stessa chiave e' la garanzia d'integrita' (architettura.md). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- (0.16) Aggiornamenti senza tocchi: da Android 12 un'app che aggiorna SE
         STESSA (stessa firma) puo' installare la versione nuova senza la conferma
         dell'utente. Se Android la chiede lo stesso, resta la notifica di prima. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Visibilita' pacchetti: serve per mostrare nome delle app misurate.
         Sideload: nessuna policy Play si applica (architettura.md). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- (0.9) Avviso a tutto schermo quando si va oltre una regola: da Android
         10 un'app dietro le quinte apre una schermata sopra l'app in uso solo
         con "Mostra sopra le altre app", che il figlio concede (o no) dalle
         Impostazioni. Senza, resta la notifica. Non blocca niente. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- (0.13) Il blocco delle faccende programmato parte all'ora giusta anche
         senza rete: una sveglia ESATTA lo dice ("Prima le faccende") anche a
         telefono fermo. USE_EXACT_ALARM da Android 13 (concesso
         all'installazione; la regola del Play Store sugli usi ammessi non conta
         per un'app installata a mano), SCHEDULE_EXACT_ALARM solo su Android 12.
         Se Android non la concede, si ripiega sulla sveglia inesatta. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- (0.14) Il battito in stand-by: la sveglia tiene sveglio il telefono il
         tempo di un battito (wakelock breve, al massimo un minuto). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".PactumApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nome_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.PactumFiglio">

        <!-- (0.15) adjustResize: col bordo pieno la finestra passa a Compose lo
             spazio della tastiera (imePadding), e i campi restano sopra di lei. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- (0.9) L'avviso a tutto schermo. Task suo (taskAffinity) e fuori
             dalle recenti: "Ho capito" chiude e si torna all'app di prima, non
             a una schermata di Pactum rimasta aperta sotto. singleTask: un
             avviso nuovo mentre c'è ancora quello vecchio si aggiunge a lui. -->
        <activity
            android:name=".avviso.AvvisoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="eu.stgm.pactum.figlio.avviso" />

        <!-- (0.11) La barriera di una Sessione: "Sei in sessione «Studio»" con
             un solo pulsante, Esci (alla schermata Home). Come l'avviso: task
             suo, fuori dalle recenti, aperta dal servizio con "Mostra sopra le
             altre app". Mai sopra il blocco schermo (niente showWhenLocked). -->
        <activity
            android:name=".sessione.BarrieraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="eu.stgm.pactum.figlio.barriera" />

        <!-- (0.12) La pagina animata di inizio e fine di una Sessione: tre secondi
             e mezzo, poi si chiude da sola (o con un tocco). Come la barriera:
             task sua e fuori dalle recenti, così chiusa si torna dove si era;
             alla fine di una sessione può aprirsi sopra l'app in uso grazie a
             "Mostra sopra le altre app". Mai sopra il blocco schermo. -->
        <activity
            android:name=".sessione.PaginaSessioneActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="eu.stgm.pactum.figlio.pagina" />

        <!-- (0.13) La barriera delle faccende: "Prima le faccende", con un solo
             pulsante, Apri Pactum. Come quella delle Sessioni: task suo, fuori
             dalle recenti, aperta dal servizio con "Mostra sopra le altre
             app". Mai sopra il blocco schermo (niente showWhenLocked). -->
        <activity
            android:name=".faccende.BarrieraFaccendeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="eu.stgm.pactum.figlio.faccende" />

        <!-- (0.13) La foto di una faccenda: la fotocamera scrive lo scatto in un
             file di Pactum, condiviso solo per quello scatto e solo in
             scrittura temporanea (FileProvider, cartella faccende/scatti). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.foto"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_condivisi" />
        </provider>

        <!-- (0.14) La sveglia del battito ogni ~15 minuti, anche in stand-by.
             Interno: l'invoca solo il PendingIntent di AlarmManager. -->
        <receiver
            android:name=".sync.SvegliaBattitoReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- (0.14) L'avviso di spegnimento: da Android 9 arriva solo al
             ricevitore registrato dal servizio; questo vale per Android 8 e
             per le varianti di alcune marche. Non esportato: nessun'altra app
             può far credere a Pactum che il telefono si spenga. -->
        <receiver
            android:name=".sync.SpegnimentoReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWEROFF" />
            </intent-filter>
        </receiver>

        <!-- (0.13) La sveglia del blocco programmato delle faccende. Interno:
             l'invoca solo il PendingIntent di AlarmManager. -->
        <receiver
            android:name=".faccende.SvegliaFaccendeReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".servizio.PactumService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Registro trasparente uso app per patto familiare figlio-genitore" />
        </service>

        <!-- Osservazione dei siti visitati (v2.3). VPN LOCALE che instrada SOLO
             il DNS: nessun altro traffico entra nel tunnel, niente viene mai
             bloccato. exported="true" con BIND_VPN_SERVICE e' la forma
             richiesta da Android: il permesso ce l'ha solo il sistema. -->
        <service
            android:name=".siti.OsservatoreSitiService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- (0.9) Anche MY_PACKAGE_REPLACED: dopo un aggiornamento il servizio
             del testimone non riparte da solo. Arriva solo a Pactum stessa. -->
        <receiver
            android:name=".avvio.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- TIME_SET e TIMEZONE_CHANGED sono esenti dalle restrizioni sui
             broadcast impliciti: dichiarabili nel manifest (architettura.md).
             Nota: la costante Intent.ACTION_TIME_CHANGED vale "android.intent.action.TIME_SET". -->
        <receiver
            android:name=".tempo.OrologioReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Esito della sessione di PackageInstaller (auto-aggiornamento).
             Interno: l'invoca solo il PendingIntent della sessione. -->
        <receiver
            android:name=".aggiornamento.InstallReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
