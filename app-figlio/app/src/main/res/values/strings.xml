    <string name="nome_app">Pactum</string>

    <!-- Onboarding -->
    <string name="onboarding_titolo">Benvenuto in Pactum</string>
    <string name="onboarding_intro">Pactum è un testimone, non un carceriere: misura l\'uso delle app e lo racconta al patto, senza bloccare niente. Per funzionare servono tre permessi.</string>
    <string name="passo_uso_titolo">1. Accesso ai dati di utilizzo</string>
    <string name="passo_uso_descrizione">Serve per misurare quanto tempo passi nelle app. Senza questo permesso Pactum non può fare da testimone.</string>
    <string name="passo_batteria_titolo">2. Esenzione dalla batteria</string>
    <string name="passo_batteria_descrizione">Evita che Android addormenti Pactum e crei buchi nel registro.</string>
    <string name="passo_notifiche_titolo">3. Notifiche</string>
    <string name="passo_notifiche_descrizione">Per la notifica fissa del testimone e gli avvisi del patto.</string>
    <string name="passo_apri_impostazioni">Apri impostazioni</string>
    <string name="passo_fatto">Fatto</string>
    <string name="passo_da_fare">Da fare</string>
    <string name="aiuto_restrizioni_titolo">Se Android ti blocca…</string>
    <string name="aiuto_restrizioni_testo">Su Android 15 e 16, con l\'app installata dal browser, l\'interruttore “Accesso ai dati di utilizzo” parte bloccato dalle impostazioni con limitazioni. Il primo tentativo che fallisce è necessario: senza, la voce per sbloccare non compare.\n\n1. Tocca “Apri impostazioni” e prova ad attivare Pactum: comparirà “Impostazione non disponibile”.\n2. Torna qui e tocca “Apri info app”.\n3. Nella pagina dell\'app tocca il menu ⋮ in alto a destra.\n4. Scegli “Consenti impostazioni con limitazioni” e conferma con PIN o impronta.\n5. Torna su “Accesso ai dati di utilizzo” e attiva Pactum.</string>
    <string name="aiuto_apri_info_app">Apri info app</string>
    <string name="onboarding_ricontrolla">Ho fatto, ricontrolla</string>
    <string name="onboarding_nota_avvio">Appena l\'accesso ai dati di utilizzo è attivo, Pactum parte da solo.</string>

